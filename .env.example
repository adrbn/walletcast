# ─────────────────────────────────────────────────────────────
# WalletCast configuration. Copy to .env.local (dev) or set in
# your host. Only BASE_URL, ADMIN_PASSWORD and SESSION_SECRET are
# needed to start; Apple / Google are enabled when fully set.
# ─────────────────────────────────────────────────────────────

# Public URL of this server, no trailing slash. Must be HTTPS in
# production: Apple devices only talk to an HTTPS web service.
BASE_URL=http://localhost:3000

# Dashboard login
ADMIN_PASSWORD=change-me
# 32+ random characters. Generate: openssl rand -base64 48
SESSION_SECRET=

# Database. Leave DATABASE_URL empty to use the embedded PGlite
# database stored in PGLITE_DIR (fine for a single server).
# Use Postgres (Neon, Supabase, RDS…) on Vercel/serverless.
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# ── Apple Wallet (docs/setup-apple.md) ───────────────────────
# PEM values: paste as base64 (base64 -i file.pem) or as PEM with \n
APPLE_PASS_TYPE_ID=pass.com.example.walletcast
APPLE_TEAM_ID=
APPLE_SIGNER_CERT=
APPLE_SIGNER_KEY=
APPLE_SIGNER_KEY_PASSPHRASE=
APPLE_WWDR_CERT=

# ── Google Wallet (docs/setup-google.md) ─────────────────────
GOOGLE_ISSUER_ID=
# Service account JSON key, raw JSON or base64
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Day glow (optional) ──────────────────────────────────────
# Time zone whose hour drives the glow colour on day-glow cards.
GLOW_TIMEZONE=Europe/Rome
# Protects POST /api/cron/glow. Generate: openssl rand -base64 32
CRON_SECRET=
